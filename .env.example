# Supabase Configuration (for game code validation)
# Get these from your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Note: Without these, the game runs in DEV MODE
# DEV MODE accepts any game code starting with TEST or DEV
